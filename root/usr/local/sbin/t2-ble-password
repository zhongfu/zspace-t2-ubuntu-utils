#!/bin/sh
# Print the BLE management pre-shared key (the `ble.psk=` value from the
# config partition, or the random one generated on first start).
#
# The key is the only secret that authenticates a BLE client, so this reads it
# as root and nothing else can.
set -eu
if [ "$(id -u)" != 0 ]; then
	echo "t2-ble-password: run as root" >&2
	exit 1
fi
conf=/etc/t2-ble.conf
if [ ! -r "$conf" ]; then
	echo "t2-ble-password: $conf does not exist yet - t2-ble.service writes it on first start" >&2
	exit 1
fi
psk=$(sed -n 's/^T2_BLE_PSK=//p' "$conf" | head -1)
if [ -z "$psk" ]; then
	echo "t2-ble-password: no T2_BLE_PSK= line in $conf" >&2
	exit 1
fi
printf '%s\n' "$psk"
